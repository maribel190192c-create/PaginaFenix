<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registro de Usuario - MueblesFenix</title>
    <link rel="stylesheet" href="styleusuario.css">
</head>
<body>
    <div class="container">
        <div class="form-container">
            <div class="form-header">
                <h1>MueblesFenix</h1>
                <h2>Registro de Usuario</h2>
                <p>Únete a nuestra comunidad y disfruta de los mejores muebles para tu hogar</p>
            </div>

            <form id="form-registro" class="form">
                <div class="input-group">
                    <label for="nombre">Nombre Completo *</label>
                    <input type="text" id="nombre" name="nombre" placeholder="Ingresa tu nombre completo" required>
                </div>

                <div class="input-group">
                    <label for="documento">Número de Documento *</label>
                    <input type="text" id="documento" name="documento" placeholder="Ingresa tu número de documento" required>
                </div>

                <div class="input-group">
                    <label for="email">Correo Electrónico *</label>
                    <input type="email" id="email" name="email" placeholder="tu@email.com" required>
                </div>

                <div class="input-group">
                    <label for="telefono">Teléfono *</label>
                    <input type="tel" id="telefono" name="telefono" placeholder="+57 300 123 4567" required>
                </div>

                <div class="input-group">
                    <label for="direccion">Dirección *</label>
                    <input type="text" id="direccion" name="direccion" placeholder="Calle 123 #45-67, Ciudad" required>
                </div>

                <div class="input-group">
                    <label for="usuario">Nombre de Usuario *</label>
                    <input type="text" id="usuario" name="usuario" placeholder="Elige un nombre de usuario" required>
                </div>

                <div class="input-group">
                    <label for="password">Contraseña *</label>
                    <input type="password" id="password" name="password" placeholder="Mínimo 6 caracteres" required minlength="6">
                </div>

                <div class="input-group">
                    <label for="confirmar-password">Confirmar Contraseña *</label>
                    <input type="password" id="confirmar-password" name="confirmar-password" placeholder="Repite tu contraseña" required>
                </div>

                <div class="input-group">
                    <label for="tipo-usuario">Tipo de Usuario</label>
                    <select id="tipo-usuario" name="tipo-usuario">
                        <option value="cliente">Cliente</option>
                        <option value="mayorista">Mayorista</option>
                    </select>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="terminos" name="terminos" required>
                    <label for="terminos">Acepto los <a href="#" class="link">términos y condiciones</a> y la <a href="#" class="link">política de privacidad</a></label>
                </div>

                <div class="checkbox-group">
                    <input type="checkbox" id="newsletter" name="newsletter">
                    <label for="newsletter">Deseo recibir ofertas y novedades por correo electrónico</label>
                </div>

                <button type="submit" class="btn-registro">Crear Cuenta</button>
            </form>

            <div class="form-footer">
                <p>¿Ya tienes una cuenta? <a href="#" id="btn-login" class="link">Iniciar Sesión</a></p>
                <a href="Index.html" class="btn-volver">← Volver al Inicio</a>
            </div>
        </div>
    </div>

    <!-- Modal de Login -->
    <div id="modal-login" class="modal">
        <div class="modal-content">
            <span class="close">&times;</span>
            <h2>Iniciar Sesión</h2>
            <form id="form-login">
                <div class="input-group">
                    <label for="login-usuario">Usuario o Email</label>
                    <input type="text" id="login-usuario" name="usuario" required>
                </div>
                <div class="input-group">
                    <label for="login-password">Contraseña</label>
                    <input type="password" id="login-password" name="password" required>
                </div>
                <button type="submit" class="btn-login">Iniciar Sesión</button>
            </form>
        </div>
    </div>

    <script src="scriptusuario.js"></script>
